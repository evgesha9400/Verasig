{
  "$schema": "https://raw.githubusercontent.com/evgesha9400/rig/main/rig.schema.json",
  "project": "verasig",
  "default_mode": "native",
  "scopes": {
    "db": [
      "db"
    ],
    "backend": [
      "db",
      "backend"
    ],
    "full": [
      "db",
      "backend",
      "frontend"
    ]
  },
  "modes": {
    "native": {
      "services": {
        "db": {
          "type": "compose",
          "compose_file": "docker-compose.yml",
          "compose_service": "db",
          "compose_port": 5432,
          "env_files": [
            "apps/backend/.env"
          ],
          "env": {
            "VERASIG_DB_PORT": "5434"
          },
          "description": "Local PostgreSQL 16 database container"
        },
        "backend": {
          "type": "fd",
          "cwd": "apps/backend",
          "python": ".venv/bin/python",
          "app": "verasig.entrypoints.api:create_app_from_env",
          "factory": true,
          "depends_on": [
            "db"
          ],
          "env_files": [
            "apps/backend/.env"
          ],
          "env": {
            "VERASIG_DB_HOST": "127.0.0.1",
            "VERASIG_DB_PORT": "{db_port}",
            "VERASIG_CORS_ORIGINS": "[\"http://localhost:5173\",\"http://127.0.0.1:5173\"]"
          },
          "preferred_port": 8000,
          "healthcheck_path": "/health",
          "description": "FastAPI backend server"
        },
        "frontend": {
          "type": "port",
          "cwd": "apps/frontend",
          "depends_on": [
            "backend"
          ],
          "env": {
            "VITE_VERASIG_API_URL": "http://localhost:{backend_port}"
          },
          "command": [
            "npm",
            "run",
            "dev",
            "--workspace",
            "verasig-web",
            "--",
            "--host",
            "127.0.0.1",
            "--port",
            "{port}",
            "--strictPort"
          ],
          "preferred_port": 5173,
          "healthcheck_path": "/",
          "description": "React + Vite frontend development server"
        }
      }
    }
  }
}
