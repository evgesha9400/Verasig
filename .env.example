# Verasig Stage 0 — copy to .env (gitignored). All vars are prefixed VERASIG_.

# Postgres connection (default matches the docker-compose `db` service).
VERASIG_DATABASE_URL=postgresql+psycopg://verasig:verasig@db:5432/verasig

# Where the Telethon StringSession is persisted inside the container
# (the writable `tgsession` volume mounted at /session).
VERASIG_SESSION_PATH=/session/telegram.session

# Telegram user-account API credentials (https://my.telegram.org).
# Needed for the login/backfill/live slices — leave commented for Slice 0.
# VERASIG_TELEGRAM_API_ID=
# VERASIG_TELEGRAM_API_HASH=
# Phone of the (throwaway) account; `login` prompts for the code + 2FA password.
# VERASIG_TELEGRAM_PHONE=+15551234567
