{
  "name": "verasig-frontend-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "design-system",
    "product",
    "marketing"
  ],
  "scripts": {
    "format": "prettier --write \"product/**/*.{js,jsx,ts,tsx,json,css,html}\" \"marketing/**/*.{js,jsx,ts,tsx,json,css,html}\" \"design-system/**/*.{js,jsx,ts,tsx,json,css,html}\" \"package*.json\"",
    "format:check": "prettier --check \"product/**/*.{js,jsx,ts,tsx,json,css,html}\" \"marketing/**/*.{js,jsx,ts,tsx,json,css,html}\" \"design-system/**/*.{js,jsx,ts,tsx,json,css,html}\" \"package*.json\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @verasig/design-system && npm run test --workspace verasig-frontend -- --run && npm run test --workspace verasig-marketing -- --run",
    "build": "npm run build --workspace verasig-frontend && npm run build --workspace verasig-marketing"
  },
  "devDependencies": {
    "prettier": "^3.8.4"
  }
}
