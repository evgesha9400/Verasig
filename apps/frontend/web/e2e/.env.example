# E2E login credentials — copy this file to `e2e/.env` (git-ignored) and fill in.
#
# The Playwright harness logs in via POST $E2E_API_URL/auth/login on every run
# and reuses the session, so it needs a REAL account on your LOCAL backend.
# Prefer an account that has Telegram connected and feeds — a fresh account
# renders an empty feeds view, so the feed specs will skip.

E2E_EMAIL=you@example.com
E2E_PASSWORD=your-local-dev-password

# Optional overrides (defaults shown):
# E2E_BASE_URL=http://localhost:5173
# E2E_API_URL=http://localhost:8000

# CI only: register a throwaway user instead of logging in (E2E_EMAIL/PASSWORD
# are then unused). Never set it against the live site.
# E2E_REGISTER=1

# checkout.spec.js signs a simulated Stripe webhook with this. Set it to the
# backend's VERASIG_STRIPE_WEBHOOK_SECRET (apps/backend/.env); the spec skips
# locally when it is missing. CI sets both to the same throwaway value.
# E2E_STRIPE_WEBHOOK_SECRET=whsec_...

# password-reset.spec.js reads the reset email from Mailpit's HTTP API. Locally,
# `make dev` and `docker compose --profile site` both run Mailpit on :8025; the
# spec skips locally when this is unset. CI sets it.
# E2E_MAIL_API_URL=http://localhost:8025
