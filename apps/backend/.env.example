# Verasig — run `make env` from the repo root to create .env.
# All vars are prefixed VERASIG_.

# Postgres connection parts.
# Host CLI default is localhost. Docker Compose overrides VERASIG_DB_HOST=db
# for the app container.
VERASIG_DB_HOST=localhost
VERASIG_DB_PORT=5432
VERASIG_DB_NAME=verasig
VERASIG_DB_USER=verasig
VERASIG_DB_PASSWORD=verasig

# Optional full SQLAlchemy URL override, highest priority.
# VERASIG_DATABASE_URL_OVERRIDE=postgresql+psycopg://verasig:verasig@localhost:5432/verasig

# Where the Telethon StringSession is persisted inside the container
# (the writable `tgsession` volume mounted at /session).
VERASIG_SESSION_PATH=/session/telegram.session

# Telegram user-account API credentials (https://my.telegram.org).
# Needed for login, backfill, and live capture.
# VERASIG_TELEGRAM_API_ID=
# VERASIG_TELEGRAM_API_HASH=
# Phone of the account; `login` prompts for the code + 2FA password.
# VERASIG_TELEGRAM_PHONE=+15551234567
