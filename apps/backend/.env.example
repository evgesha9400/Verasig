# Verasig — run `make env` from the repo root to create .env.
# All vars are prefixed VERASIG_.

# Postgres connection parts.
# Host CLI default is localhost. Docker Compose overrides VERASIG_DB_HOST=db
# for the app container.
VERASIG_DB_HOST=localhost
VERASIG_DB_PORT=5432
VERASIG_DB_NAME=verasig
VERASIG_DB_USER=verasig
VERASIG_DB_PASSWORD=verasig

# Optional full SQLAlchemy URL override, highest priority.
# VERASIG_DATABASE_URL_OVERRIDE=postgresql+psycopg://verasig:verasig@localhost:5432/verasig

# Telegram API credentials are submitted per user through the API and stored
# encrypted in Postgres. No process-level Telegram session file is used.

# API auth and secret storage.
VERASIG_ENV=local
VERASIG_JWT_SECRET=dev-secret
VERASIG_JWT_TTL_DAYS=7
# This deterministic key is for local development only.
# Generate a production key with:
# uv run python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Rotate by prepending a new key_id:base64key pair and keeping old pairs.
VERASIG_SECRET_KEYS=2026-06:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Claude Code CLI runner.
VERASIG_CLAUDE_CODE_OAUTH_TOKEN=
VERASIG_CLAUDE_CODE_MODEL=sonnet

# Browser origins allowed to call the API.
VERASIG_CORS_ORIGINS='["http://localhost:5173"]'

# Stripe billing. Test mode until launch: use sk_test_ keys and test Price ids.
# Billing requests fail with BILLING_NOT_CONFIGURED while a value is blank.
VERASIG_STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint. Locally, `stripe listen` prints it.
VERASIG_STRIPE_WEBHOOK_SECRET=
# Price ids of the Trader product: $49 monthly, and $39/month billed yearly.
VERASIG_STRIPE_PRICE_TRADER_MONTHLY=
VERASIG_STRIPE_PRICE_TRADER_YEARLY=
# Public origin of the web app; Checkout and the billing portal return here.
VERASIG_SITE_URL=http://localhost:5173
